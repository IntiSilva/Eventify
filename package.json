{
  "name": "eventify-history",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "prod": "npm run build && npm run start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "e2e:guard": "tsx scripts/e2e-guard.ts",
    "e2e:reset": "npm run e2e:guard && dotenv -e .env.e2e -- prisma db push --force-reset --accept-data-loss",
    "e2e:seed": "npm run e2e:guard && dotenv -e .env.e2e -- tsx prisma/seed-e2e.ts",
    "e2e:gen": "dotenv -e .env.e2e -- prisma generate",
    "pree2e": "npm run e2e:reset && npm run e2e:seed",
    "pree2e:ui": "npm run e2e:reset && npm run e2e:seed",
    "e2e": "dotenv -e .env.e2e -- playwright test",
    "e2e:ui": "dotenv -e .env.e2e -- playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@clerk/themes": "^2.2.45",
    "@hookform/resolvers": "^5.0.1",
    "@lordicon/react": "^1.11.0",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "0.0.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.16.0",
    "next": "^15.3.6",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "^19.0.1",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.0.1",
    "react-email": "4.0.16",
    "react-hook-form": "^7.56.4",
    "react-phone-number-input": "^3.4.12",
    "resend": "^4.5.2",
    "sonner": "^2.0.3",
    "svix": "^1.65.0",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.25.7"
  },
  "overrides": {
    "react-hook-form": "$react-hook-form"
  },
  "devDependencies": {
    "@clerk/backend": "2.20.0",
    "@clerk/nextjs": "6.34.5",
    "@clerk/testing": "1.13.12",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.6",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^27.1.0",
    "msw": "^2.11.6",
    "prisma": "^6.8.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
