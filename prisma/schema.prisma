generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum ReminderType {
  FORTY_EIGHT_HOURS
  SAME_DAY
  MINUTES_BEFORE
}

enum ContactPhoneApps {
  whatsapp
  telegram
  both
}

enum UserRole {
  admin
  organizer
  user
}

enum EventCategory {
  music
  sports
  education
  tech
  health
  art
  nightlife
  gastronomy
  films
  theater
  fitness
  business
  finance
  fashion
  travel
  gaming
  workshop
}


enum RSVPStatus {
  pending
  confirmed
  canceled
}

enum RSVPAttendanceEntitlementStatus {
  active
  refund_pending_hold
  revoked_refunded
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String    @unique @db.VarChar(25)
  normalizedUsername  String   @unique @db.VarChar(25)

  
  clerkId   String    @unique
  role      UserRole  @default(user)

  //Data for avatar component
  firstName String?   @db.VarChar(50)
  lastName  String?   @db.VarChar(50)
  imageUrl  String?
  hasImage  Boolean?

  phoneNumber String? @unique @db.VarChar(30)

  stripeConnectAccountId            String?   @unique
  stripeConnectChargesEnabled       Boolean   @default(false)
  stripeConnectPayoutsEnabled       Boolean   @default(false)
  stripeConnectDetailsSubmitted     Boolean   @default(false)
  stripeConnectOnboardingCompletedAt DateTime?
  stripeConnectStatusUpdatedAt      DateTime?

  rsvps     RSVP[]
  payments  Payment[]
  createdAt DateTime @default(now())

  createdEvents Event[] @relation("UserCreatedEvents")


}

model Event {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(60)
  normalizedTitle String?  

  description String
  date        DateTime
  eventTimeZone         String  @db.VarChar(50)
  eventLocalDateKey     Int
  eventLocalMinuteOfDay Int
  location    String   @db.VarChar(255)
  normalizedLocation String?

  category    EventCategory
  featured    Boolean   @default(false)
  featuredByAdmin Boolean     @default(false)


  createdBy   String 
  creator     User   @relation("UserCreatedEvents", fields: [createdBy], references: [clerkId], onDelete: Cascade)

  contactEmail  String?
  contactPhone  String?
  contactPhoneApps ContactPhoneApps?
  isPaid      Boolean @default(false)
  priceCents  Int?
  currency    String? @db.VarChar(3)
  currentPriceVersionId String? @unique
  archivedAt  DateTime?

  rsvps       RSVP[]
  payments    Payment[]
  priceVersions EventPriceVersion[] @relation("EventAllPriceVersions")
  currentPriceVersion EventPriceVersion? @relation("EventCurrentPriceVersion", fields: [currentPriceVersionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())


  @@index([normalizedTitle])
  @@index([normalizedLocation])
  // Index for event time-based list filters
  @@index([date])
  @@index([eventLocalDateKey])
}

model EventPriceVersion {
  id          String   @id @default(cuid())
  eventId      String
  versionNumber Int
  isPaid       Boolean
  amountCents  Int?
  currency     String? @db.VarChar(3)
  createdBy    String?
  effectiveAt  DateTime @default(now())
  supersededAt DateTime?
  createdAt    DateTime @default(now())

  event Event @relation("EventAllPriceVersions", fields: [eventId], references: [id], onDelete: Cascade)
  currentForEvent Event? @relation("EventCurrentPriceVersion")
  payments Payment[]

  @@unique([eventId, versionNumber])
  @@index([eventId, createdAt])
  @@index([eventId, effectiveAt])
}

model RSVP {
  id      String @id @default(cuid())
  userId  String
  eventId String
  status  RSVPStatus @default(pending)
  attendanceEntitlementStatus RSVPAttendanceEntitlementStatus @default(active)

  user  User  @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reminderPreferenceType ReminderType?
  reminderOffsetMinutes  Int?
  reminderScheduledAt    DateTime?
  reminderSentAt         DateTime?
  // -----------------------------------------
  payments Payment[]

  @@unique([userId, eventId])
}

enum PaymentStatus {
  pending
  succeeded
  failed
  canceled
}

enum RefundRequestStatus {
  requested
  approved
  rejected
  processing
  succeeded
  failed
  canceled
}

enum RefundRequestSource {
  USER_REQUEST
  MANUAL_OVERRIDE
  SYSTEM_COMPENSATION
}

enum PaymentPayoutTarget {
  platform
  organizer
}

model Payment {
  id                    String        @id @default(cuid())
  stripePaymentIntentId String        @unique
  status                PaymentStatus @default(pending)
  payoutTarget          PaymentPayoutTarget @default(platform)
  amountCents           Int
  currency              String        @db.VarChar(3)
  destinationAccountId  String?
  transferGroup         String?
  applicationFeeAmount  Int?
  stripeChargeId        String?
  stripeBalanceTransactionId String?
  stripeTransferId      String?
  stripeApplicationFeeId String?
  ticketEmailSentAt     DateTime?
  eventId               String
  userId                String
  rsvpId                String?
  priceVersionId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  rsvp  RSVP? @relation(fields: [rsvpId], references: [id], onDelete: SetNull)
  priceVersion EventPriceVersion? @relation(fields: [priceVersionId], references: [id], onDelete: SetNull)
  refundRequest RefundRequest?

  @@index([eventId])
  @@index([userId])
  @@index([priceVersionId])
  @@index([eventId, status])
  @@index([eventId, userId, status])
}

model RefundRequest {
  id                String              @id @default(cuid())
  paymentId         String              @unique
  requestedByUserId String
  source            RefundRequestSource @default(USER_REQUEST)
  reason            String?             @db.VarChar(500)
  status            RefundRequestStatus @default(requested)
  stripeRefundId    String?             @unique
  refundEmailSentAt DateTime?
  refundReference   String?             @db.VarChar(64)
  refundReferenceType String?           @db.VarChar(64)
  refundReferenceStatus String?         @db.VarChar(32)
  refundSucceededAt DateTime?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?             @db.VarChar(500)
  attemptCount      Int                 @default(0)
  lastError         String?             @db.VarChar(1000)
  lastAttemptAt     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([requestedByUserId])
  @@index([status])
}
